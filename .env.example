# Explicit local demonstration values only. Do not use these credentials outside the isolated demo.
DATABASE_BOOTSTRAP_PASSWORD=demo-bootstrap-password-not-for-production
DATABASE_MIGRATOR_PASSWORD=demo-migrator-password-not-for-production
DATABASE_APP_PASSWORD=demo-app-password-not-for-production
DEMO_BUSINESS_TOKEN=rc-demo-business-token
DEMO_ADMIN_TOKEN=rc-demo-admin-token
DEMO_VENDOR_SECRET=demo-vendor-secret-not-for-production
DEMO_VENDOR_SECRET_VERSION=demo-v1

# Normal baseline: 10 tenants, 20 arrivals/second, supplier 100 ms; pools are per process.
WORKER_GLOBAL_CONCURRENCY=10
WORKER_PROVIDER_CONCURRENCY=3
WORKER_POLL_INTERVAL=100ms
WORKER_BUSINESS_TIMEOUT=10s
WORKER_ATTEMPT_TIMEOUT=30s
WORKER_LEASE_DURATION=90s
DB_POOL_SIZE=10
RETRY_BASE_DELAY=30s
RETRY_MAX_DELAY=1h
PROTECTION_OPEN_DURATION=30s
PROTECTION_RETRY_DELAY=1s
PROTECTION_JITTER=1s
DELIVERY_MAX_ATTEMPTS=12
DELIVERY_RUN_DURATION=24h
ADMISSION_REQUESTS_PER_SECOND=100
ADMISSION_BURST_CAPACITY=200
ADMISSION_MAX_BACKLOG=10000
OBSERVABILITY_SAMPLE_INTERVAL=1s
TEST_DATABASE_PORT=55432
